# ==============================================================================
# PROJECT: mini project-XMARs
# .gitignore - Production Ready
# ==============================================================================

# ─── Virtual Environments ─────────────────────────────────────────────────────
.venv/
venv/
env/
bin/
include/
lib/
share/
pyvenv.cfg
pip-selfcheck.json

# ─── Python Cache & Temporary Files ───────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ipynb_checkpoints/
.mypy_cache/
.tox/
.coverage
htmlcov/

# ─── Large Biomedical Datasets (CRITICAL: 1GB+ Files) ─────────────────────────
# Ignoring raw data to prevent GitHub upload failures (100MB limit)
**/data/raw/
**/data/luad_tcga/
*.csv
*.xlsx
*.seg
!DELIVERY_SUMMARY.txt
!*.md

# ─── Generated Outputs & Artifacts ───────────────────────────────────────────
# Ignore transient analysis results and visualizations
**/figures/
**/output/
**/figures_mutation/
**/pipeline_results/
project_tree_full.txt

# ─── Logs ─────────────────────────────────────────────────────────────────────
*.log
_pip_log.txt
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── Environment & Secrets ────────────────────────────────────────────────────
# MOVE GEMINI_API_KEY TO .env FILE
.env
.flaskenv
secrets.py
*.key
*.pem

# ─── OS Specific ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── IDE Specific ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ──────────────────────────────────────────────────────────────────────────────
# EXPLICITLY KEEP (Whitelisting)
# ──────────────────────────────────────────────────────────────────────────────

# KEEP trained models as requested
!**/models/*.pkl
!**/models/*.json

# KEEP specific necessary data files (if small and required for app)
!data/processed/encoders/
!data/processed/encoders/*.pkl
!MUTATION/data/processed/encoders/
!MUTATION/data/processed/encoders/*.pkl

# KEEP source and docs
!*.py
!*.md
!requirements.txt
